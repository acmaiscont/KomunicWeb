<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>KomunicApp</AssemblyName>
    <RootNamespace>KomunicApp</RootNamespace>
    <Version>1.0.2</Version>

    <!-- Ícone embutido no executável -->
    <ApplicationIcon>komunic-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ícone do app marcado para estar no projeto, mas não será copiado pois é embutido -->
    <None Include="komunic-icon.ico" />
    
    <!-- Arquivo de configuração copiado para saída -->
    <Content Include="config.json" ExcludeFromSingleFile="true">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    
    <!-- Log copiado somente se atualizado -->
    <Content Include="app_log.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.10" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.10" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.1901.177" />
  </ItemGroup>

</Project>
